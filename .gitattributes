# Normalize line endings: text files are LF in the repo, checked out per-platform.
# Without this, core.autocrlf=true + core.safecrlf=true aborts commits of new
# LF files ("LF would be replaced by CRLF").
* text=auto eol=lf

# Windows-native scripts stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries: never normalize.
*.png binary
*.jpg binary
*.ico binary
*.snk binary
